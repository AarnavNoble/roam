# Copy to backend/.env for local development. backend/config.py is the only
# place these are read. Do not commit backend/.env.
#
# The server needs one of JWT_SECRET or ROAM_DEV=1 to start (see Auth below).
# Everything else is optional: with nothing else set it stores data in SQLite
# and writes itinerary text without an LLM.

# ── Development ──────────────────────────────────────────────────────────────
# Marks this as a development machine: the server may start without a
# JWT_SECRET and signs tokens with a well-known default. Never set it on a
# server other people can reach.
ROAM_DEV=1

# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API key. Without it every itinerary is written from OSM tags and marked
# "llm:fallback".
GROQ_API_KEY=
# Models tried in order. A model that is retired, rate limited or timing out
# is skipped by its circuit breaker and the next one answers.
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# ── Routing ──────────────────────────────────────────────────────────────────
# OpenRouteService key for real road and footpath travel times. Without it
# travel times are straight-line estimates (by design, not flagged). With it,
# an ORS failure falls back to the same estimates and is flagged
# "matrix:haversine".
ORS_API_KEY=

# ── Places ───────────────────────────────────────────────────────────────────
# Overpass API mirrors, comma separated, tried in order with hedging.
# OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. Unset means SQLite at data/roam.db, which is fine on a laptop
# but is lost when a container is replaced. Production, docker compose and CI
# use Postgres. Migrations are applied automatically at startup.
# DATABASE_URL=postgresql+psycopg://roam:roam@localhost:15434/roam

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret that signs login tokens (HS256). Required: without it the server
# refuses to start unless ROAM_DEV=1, because the fallback is public and anyone
# could forge a token for any account. Use at least 32 random bytes, for
# example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
# JWT_SECRET=
# How long a login token is valid, in hours. Default 720 (30 days).
# JWT_TTL_HOURS=720

# ── Rate limiting ────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the server. Rate limits are per client
# address, taken from X-Forwarded-For counting this many entries from the
# right (entries further left are written by the client and can be faked).
# 1 suits Hugging Face Spaces and most single-proxy hosts. Set 0 when the
# server is reached directly, so the header is ignored altogether.
# TRUSTED_PROXIES=1

# ── Request budget ───────────────────────────────────────────────────────────
# Wall-clock seconds one itinerary request may take across all stages. A slow
# stage shortens the timeouts of the stages after it. If the budget runs out
# before POIs are in hand the request is a 503; after that point the remaining
# network stages are skipped and the response is degraded.
# REQUEST_DEADLINE_S=60

# ── Tracing ──────────────────────────────────────────────────────────────────
# OTLP/HTTP endpoint of a collector (Jaeger, Tempo, ...). Unset means spans are
# only aggregated in process and shown at /api/metrics/latency.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
